{
  "name": "front-plas",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:unal": "PLAS_SITE=https://plas.unal.edu.co PLAS_BASE=/ astro build",
    "build:pages": "PLAS_SITE=https://unplas.github.io PLAS_BASE=/web_plas astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "node --test --experimental-strip-types src/scripts/*.test.ts scripts/harvest.test.mjs",
    "harvest:publications": "node scripts/harvest-publications.mjs",
    "harvest:theses": "node scripts/harvest-theses.mjs",
    "harvest:project": "node scripts/project-site.mjs",
    "harvest:bootstrap": "node scripts/bootstrap-harvest.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "marked": "^18.0.13",
    "tailwindcss": "^4.3.3"
  },
  "allowScripts": {
    "esbuild": true
  }
}
