---
import Layout from '../layouts/Layout.astro';
import { people, students } from '../data/placeholders';
---

<Layout title="Equipo">
  <section class="page-section wrap" aria-labelledby="people-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">People</p>
      <h1 id="people-heading" class="page-head__title">Equipo</h1>
      <p class="page-head__lede">
        Docentes e integrantes del grupo de investigación.
      </p>
    </header>

    <h2 class="people-section__title">Docentes</h2>
    <ul class="faculty-list">
      {
        people.map((person) => (
          <li>
            <article class="faculty-card faculty-card--row">
              <div class="faculty-card__media" aria-hidden="true" />
              <div class="faculty-card__body">
                <h3 class="faculty-card__name">{person.name}</h3>
                <p class="faculty-card__role">{person.role}</p>
                <p class="faculty-card__role">{person.meta}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="page-section wrap" aria-labelledby="students-heading">
    <h2 id="students-heading" class="people-section__title">Estudiantes</h2>
    <ul class="student-list">
      {
        students.map((person) => (
          <li class="student-row">
            <h3 class="student-row__name">{person.name}</h3>
            <p class="student-row__meta">
              {person.role} · {person.meta}
            </p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
