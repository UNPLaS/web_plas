---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PersonRow from '../components/PersonRow.astro';
import SectionHeader from '../components/SectionHeader.astro';
import SectionPanel from '../components/SectionPanel.astro';
import { people } from '../data/placeholders';

const featured = people.filter((p) => p.hasPhoto);
const listed = people.filter((p) => !p.hasPhoto);
---

<Layout title="People" pattern="directory">
  <SectionPanel>
    <PageHeader
      title="People"
      lead="Secciones agrupadas + filas persona (foto + nombre + rol + meta)."
    />
    <nav class="mt-6 flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold" aria-label="Secciones">
      <a href="#featured">Destacados</a>
      <a href="#listed">Listado</a>
    </nav>
  </SectionPanel>

  <SectionPanel>
    <section id="featured" class="scroll-mt-24">
      <SectionHeader title="Destacados" lead="Personas con placeholder de foto." />
      <PersonRow items={featured} />
    </section>
  </SectionPanel>

  <SectionPanel>
    <section id="listed" class="scroll-mt-24">
      <SectionHeader title="Listado" lead="Misma fila, sin foto." />
      <PersonRow items={listed} showLabel={false} />
    </section>
  </SectionPanel>
</Layout>
