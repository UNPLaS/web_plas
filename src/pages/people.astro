---
import Layout from '../layouts/Layout.astro';
import TypeChip from '../components/TypeChip.astro';
import StudentCard from '../components/StudentCard.astro';
import {
  people,
  activeStudentSections,
  historicalStudentSections,
  researchLines,
} from '../data/site';
---

<Layout title="Equipo">
  <section class="page-section wrap" aria-labelledby="people-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">Equipo</p>
      <h1 id="people-heading" class="page-head__title">Equipo</h1>
      <p class="page-head__lede">
        Docentes e integrantes del grupo de investigación.
      </p>
    </header>

    <h2 class="people-section__title">Docentes</h2>
    <ul class="faculty-list">
      {
        people.map((person) => (
          <li id={person.anchor} class="people-anchor">
            <article class="faculty-card faculty-card--stack">
              <div class="faculty-card__media">
                {person.image ? <img src={person.image} alt="" loading="lazy" /> : null}
              </div>
              <div class="faculty-card__body">
                <div class="faculty-card__chips">
                  <TypeChip typology={person.roleChip} />
                </div>
                <h3 class="faculty-card__name">{person.name}</h3>
                {person.meta ? <p class="faculty-card__meta">{person.meta}</p> : null}
                {
                  person.profileLinks.length > 0 && (
                    <ul class="faculty-card__profiles">
                      {person.profileLinks.map((link) => (
                        <li>
                          <a class="btn btn--soft" href={link.href} target="_blank" rel="noreferrer">
                            {link.label}
                          </a>
                        </li>
                      ))}
                    </ul>
                  )
                }
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="page-section wrap"
    aria-labelledby="students-heading"
    data-student-filter-root
  >
    <h2 id="students-heading" class="people-section__title">Estudiantes</h2>

    <div class="student-filters" role="group" aria-label="Filtrar estudiantes por línea">
      <button type="button" class="student-filter" data-student-filter="all" aria-pressed="true">
        Todos
      </button>
      {
        researchLines.map((line) => (
          <button
            type="button"
            class="student-filter"
            data-student-filter={line.id}
            aria-pressed="false"
            style={`--chip-color: ${line.color}`}
          >
            {line.shortTitle}
          </button>
        ))
      }
    </div>

    <div class="students-block">
      <h3 class="people-section__subtitle">Activos</h3>
      {
        activeStudentSections.length > 0 ? (
          <>
            {activeStudentSections.map((sec) => (
              <div class="students-degree">
                <h4 class="students-degree__title">{sec.title}</h4>
                <ul class="works-list">
                  {sec.items.map((person) => (
                    <li data-student-lines={person.lineIds.join(' ')}>
                      <StudentCard student={person} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="students-empty" data-students-empty hidden>
              No hay estudiantes activos en esta línea.
            </p>
          </>
        ) : (
          <p class="students-empty">Pendiente el registro de estudiantes activos.</p>
        )
      }
    </div>

    <div class="students-block">
      <h3 class="people-section__subtitle">Histórico</h3>
      {
        historicalStudentSections.map((sec) => (
          <div class="students-degree">
            <h4 class="students-degree__title">{sec.title}</h4>
            <ul class="works-list">
              {sec.items.map((person) => (
                <li data-student-lines={person.lineIds.join(' ')}>
                  <StudentCard student={person} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="students-empty" data-students-empty hidden>
        No hay egresados en esta línea.
      </p>
    </div>
  </section>
</Layout>
