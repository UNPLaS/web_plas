---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProjectsCarousel from '../components/ProjectsCarousel.astro';
import {
  facultyItems,
  homeQuote,
  newsItems,
  recentWorks,
  researchLines,
  site,
} from '../data/placeholders';
---

<Layout title="Inicio" spine>
  <Hero brand={site.name} title={site.tagline} subtitle={site.subtitle} />

  <section class="quote-section wrap" aria-label="Cita">
    <blockquote class="quote-block">
      <p class="quote-block__text">{homeQuote.text}</p>
      <footer class="quote-block__attr">
        <cite>{homeQuote.attribution}</cite>
      </footer>
    </blockquote>
  </section>

  <section class="news-section wrap" aria-labelledby="news-heading">
    <div class="news-section__head">
      <h2 id="news-heading" class="news-section__title">Últimas novedades</h2>
      <a class="btn btn--soft" href="/events">Ver todas</a>
    </div>
    <ul class="news-gallery">
      {
        newsItems.map((item) => (
          <li>
            <a class="news-card" href={item.href}>
              <div class="news-card__media" aria-hidden="true" />
              <div class="news-card__body">
                <p class="news-card__meta">{item.meta}</p>
                <h3 class="news-card__title">{item.title}</h3>
                <p class="card-outcome">{item.outcome}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="works-section wrap" aria-labelledby="works-heading">
    <div class="works-section__head">
      <h2 id="works-heading" class="works-section__title">Trabajos recientes</h2>
      <a class="btn btn--soft" href="/catalog">Catálogo</a>
    </div>
    <ul class="works-list">
      {
        recentWorks.map((item) => (
          <li>
            <a class="works-card" href={item.href}>
              <div class="works-card__media" aria-hidden="true" />
              <div class="works-card__body">
                <p class="works-card__meta">{item.meta}</p>
                <h3 class="works-card__title">{item.title}</h3>
                <p class="works-card__author">{item.author}</p>
                <p class="card-outcome">{item.outcome}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <ProjectsCarousel />

  <section class="faculty-section section-bleed" aria-labelledby="faculty-heading">
    <div class="section-bleed__back" aria-hidden="true"></div>
    <div class="section-bleed__inner wrap">
      <div class="faculty-section__head">
        <h2 id="faculty-heading" class="faculty-section__title">Nuestros docentes</h2>
        <a class="btn btn--soft" href="/people">Equipo</a>
      </div>
      <ul class="faculty-gallery">
        {
          facultyItems.map((person) => (
            <li>
              <a class="faculty-card" href={person.href}>
                <div class="faculty-card__media" aria-hidden="true" />
                <div class="faculty-card__body">
                  <h3 class="faculty-card__name">{person.name}</h3>
                  <p class="faculty-card__role">{person.role}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="lines-section wrap" aria-labelledby="lines-heading">
    <div class="lines-section__head">
      <h2 id="lines-heading" class="lines-section__title">Líneas de investigación</h2>
      <a class="btn btn--soft" href="/lines">Líneas</a>
    </div>
    <ul class="lines-list">
      {
        researchLines.map((line) => (
          <li>
            <a class="lines-card" href={line.href}>
              <h3 class="lines-card__title">{line.title}</h3>
              <p class="lines-card__text">{line.text}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="invite-section section-bleed" aria-labelledby="invite-heading">
    <div class="section-bleed__back" aria-hidden="true"></div>
    <div class="section-bleed__inner wrap">
      <h2 id="invite-heading" class="invite-section__title">¿Quieres construir con nosotros?</h2>
      <p class="invite-section__text">
        Si traes una idea, buscas tesis o quieres colaborar, escríbenos. Revisamos
        propuestas con criterio y acompañamos el trabajo hasta un resultado sólido.
      </p>
      <p class="invite-section__cta">
        <a class="btn btn--amber" href="/contact">Escribir al grupo</a>
      </p>
    </div>
  </section>
</Layout>
