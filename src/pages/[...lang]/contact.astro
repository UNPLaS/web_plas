---
import Layout from '../../layouts/Layout.astro';
import { getContent } from '../../data/site';
import { langFromParam, langPaths, t } from '../../i18n';

export const getStaticPaths = () => langPaths();

const lang = langFromParam(Astro.params.lang);
const tr = t(lang).contact;
const { contactFields, contactForm, contactLinks, group } = getContent(lang);
---

<Layout title={tr.eyebrow} description={tr.lede}>
  <section class="page-section wrap" aria-labelledby="contact-heading">
    <header class="page-head page-head--door">
      <p class="page-head__eyebrow">{tr.eyebrow}</p>
      <h1 id="contact-heading" class="page-head__title">{tr.title}</h1>
      <p class="page-head__lede">{tr.lede}</p>
    </header>
  </section>

  <section class="contact-panel section-bleed" aria-labelledby="contact-details-heading">
    <div class="section-bleed__back" aria-hidden="true"></div>
    <div class="section-bleed__inner wrap">
      <div class:list={['contact-layout', contactForm && 'contact-layout--form']}>
        <div class="contact-layout__info">
          <h2 id="contact-details-heading" class="contact-panel__title">{tr.details}</h2>
          <ul class="contact-list">
            {
              contactFields.map((field) => (
                <li class="contact-item">
                  <p class="contact-item__label">{field.label}</p>
                  {'href' in field && field.href ? (
                    <a class="btn btn--soft" href={field.href}>
                      {field.value}
                    </a>
                  ) : (
                    <p class="contact-item__value">{field.value}</p>
                  )}
                </li>
              ))
            }
            {
              contactLinks.length > 0 && (
                <li class="contact-item">
                  <p class="contact-item__label">{tr.links}</p>
                  <ul class="contact-links">
                    {contactLinks.map((link) => (
                      <li>
                        <a class="btn btn--soft" href={link.href}>
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                </li>
              )
            }
          </ul>
          <p class="contact-panel__note">
            {
              contactForm ? tr.noteForm : tr.noteEmail
            }{' '}
            {tr.noteTail}
          </p>
        </div>

        {
          contactForm && (
            <div id="formulario" class="contact-layout__form contact-form">
              <h2 class="contact-panel__title">{tr.formTitle}</h2>
              <div class="contact-form__frame">
                <iframe
                  title={tr.formFrameTitle}
                  src={contactForm.embed}
                  loading="lazy"
                >
                  {tr.loading}
                </iframe>
              </div>
              <p class="contact-form__fallback">
                {tr.formFallback}{' '}
                <a href={contactForm.href} target="_blank" rel="noreferrer">
                  {tr.formFallbackLink}
                </a>{' '}
                {tr.formFallbackOr} <a href={`mailto:${group.email}`}>{group.email}</a>.
              </p>
            </div>
          )
        }

        {
          group.map_embed_url && (
            <div class="contact-layout__map">
              <h2 class="contact-panel__title">{tr.location}</h2>
              <div class="contact-map">
                <iframe
                  title={tr.mapTitle}
                  src={group.map_embed_url}
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  allowfullscreen
                />
              </div>
              <p class="contact-map__caption">
                {tr.mapCaption}
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Layout>
