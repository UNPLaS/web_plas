---
import Layout from '../../../layouts/Layout.astro';
import TypeChip from '../../../components/TypeChip.astro';
import MarkdownContent from '../../../components/MarkdownContent.astro';
import { getContent, type Content } from '../../../data/site';
import { langFromParam, langPaths, localePath, t } from '../../../i18n';

export function getStaticPaths() {
  return langPaths().flatMap(({ params }) =>
    getContent(langFromParam(params.lang)).blogItems.map((item) => ({
      params: { ...params, id: item.id },
      props: { item },
    })),
  );
}

interface Props {
  item: Content['blogItems'][number];
}

const lang = langFromParam(Astro.params.lang);
const tr = t(lang).blog;
const { blogItems } = getContent(lang);
const { item } = Astro.props;
const contentLang = item.contentLang !== lang ? item.contentLang : undefined;
const related = blogItems.filter((entry) => entry.id !== item.id).slice(0, 3);
const dateLabel =
  item.dateFrom && item.dateTo && item.dateFrom !== item.dateTo
    ? `${item.dateFrom} — ${item.dateTo}`
    : item.dateFrom || item.year;
const hasMarkdown = Boolean(item.content?.trim());
---

<Layout title={item.title} description={item.summary || undefined} ogType="article">
  <article class="page-section page-section--tight wrap">
    <p class="page-back">
      <a class="btn btn--soft" href={localePath(lang, '/blog')}>{tr.back}</a>
    </p>

    {
      hasMarkdown ? (
        <>
          <div class="card-topline card-topline--page">
            <TypeChip typology={item.typology} />
            {item.meta ? <p class="page-head__eyebrow">{item.meta}</p> : null}
          </div>
          <div class="detail-body detail-body--project" lang={contentLang}>
            <MarkdownContent content={item.content} />
          </div>
        </>
      ) : (
        <>
          <header class="page-head">
            <div class="card-topline card-topline--page">
              <TypeChip typology={item.typology} />
              <p class="page-head__eyebrow">{item.meta}</p>
            </div>
            <h1 class="page-head__title" lang={contentLang}>{item.title}</h1>
          </header>
          <div class="detail-body">
            <div class="page-prose">
              {item.eventType && (
                <p>
                  <strong>{tr.detail}</strong> {item.eventType}
                  {item.ambito ? ` · ${item.ambito}` : ''}
                </p>
              )}
              <p>
                <strong>{tr.dates}</strong> {dateLabel}
              </p>
              {item.place && item.place !== 'No informado' && (
                <p>
                  <strong>{tr.place}</strong> {item.place}
                </p>
              )}
              {item.participation && (
                <p>
                  <strong>{tr.participation}</strong> {item.participation}
                </p>
              )}
            </div>
          </div>
        </>
      )
    }
  </article>

  {
    related.length > 0 && (
      <section class="news-section wrap detail-related" aria-labelledby="related-heading">
        <div class="news-section__head">
          <h2 id="related-heading" class="news-section__title">{tr.related}</h2>
          <a class="btn btn--soft" href={localePath(lang, '/blog')}>{t(lang).common.seeAllFem}</a>
        </div>
        <ul class="news-gallery">
          {related.map((entry) => {
            const title =
              entry.title.length > 72 ? `${entry.title.slice(0, 72).trimEnd()}…` : entry.title;
            return (
              <li>
                <a class="news-card" href={entry.href} title={entry.title} lang={contentLang}>
                  <div class="news-card__media" aria-hidden="true">
                    {entry.image ? <img src={entry.image} alt="" loading="lazy" /> : null}
                  </div>
                  <div class="news-card__body">
                    {entry.meta ? <p class="news-card__meta">{entry.meta}</p> : null}
                    <h3 class="news-card__title">{title}</h3>
                    <div class="news-card__foot">
                      <TypeChip typology={entry.typology} />
                    </div>
                  </div>
                </a>
              </li>
            );
          })}
        </ul>
      </section>
    )
  }
</Layout>
