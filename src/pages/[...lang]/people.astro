---
import Layout from '../../layouts/Layout.astro';
import TypeChip from '../../components/TypeChip.astro';
import StudentCard from '../../components/StudentCard.astro';
import { getContent } from '../../data/site';
import { langFromParam, langPaths, t } from '../../i18n';

export const getStaticPaths = () => langPaths();

const lang = langFromParam(Astro.params.lang);
const tr = t(lang).people;
const { people, activeStudentSections, historicalStudentSections, researchLines } =
  getContent(lang);
---

<Layout title={tr.title} description={t(lang).meta.people}>
  <section class="page-section wrap" aria-labelledby="people-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">{tr.title}</p>
      <h1 id="people-heading" class="page-head__title">{tr.title}</h1>
      <p class="page-head__lede">{tr.lede}</p>
    </header>

    <h2 class="people-section__title">{tr.faculty}</h2>
    <ul class="faculty-list">
      {
        people.map((person) => (
          <li id={person.anchor} class="people-anchor">
            <a class="faculty-card faculty-card--stack" href={person.href}>
              <div class="faculty-card__media">
                {person.image ? <img src={person.image} alt="" loading="lazy" /> : null}
              </div>
              <div class="faculty-card__body">
                <div class="faculty-card__chips">
                  <TypeChip typology={person.roleChip} />
                </div>
                <h3 class="faculty-card__name">{person.name}</h3>
                {person.meta ? <p class="faculty-card__meta">{person.meta}</p> : null}
                {person.bio ? <p class="faculty-card__bio">{person.bio}</p> : null}
                <span class="faculty-card__cta">{tr.profileCta}</span>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section
    class="page-section wrap"
    aria-labelledby="students-heading"
    data-student-filter-root
  >
    <h2 id="students-heading" class="people-section__title">{tr.students}</h2>

    <div class="student-filters" role="group" aria-label={tr.filterLabel}>
      <button type="button" class="student-filter" data-student-filter="all" aria-pressed="true">
        {tr.all}
      </button>
      {
        researchLines.map((line) => (
          <button
            type="button"
            class="student-filter"
            data-student-filter={line.id}
            aria-pressed="false"
            style={`--chip-color: ${line.color}`}
          >
            {line.shortTitle}
          </button>
        ))
      }
    </div>

    <div class="students-block">
      <h3 class="people-section__subtitle">{tr.active}</h3>
      {
        activeStudentSections.length > 0 ? (
          <>
            {activeStudentSections.map((sec) => (
              <div class="students-degree">
                <h4 class="students-degree__title">{sec.title}</h4>
                <ul class="works-list">
                  {sec.items.map((person) => (
                    <li data-student-lines={person.lineIds.join(' ')}>
                      <StudentCard student={person} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <p class="students-empty" data-students-empty hidden>
              {tr.noActiveInLine}
            </p>
          </>
        ) : (
          <p class="students-empty">{tr.noActive}</p>
        )
      }
    </div>

    <div class="students-block">
      <h3 class="people-section__subtitle">{tr.historical}</h3>
      {
        historicalStudentSections.map((sec) => (
          <div class="students-degree">
            <h4 class="students-degree__title">{sec.title}</h4>
            <ul class="works-list">
              {sec.items.map((person) => (
                <li data-student-lines={person.lineIds.join(' ')}>
                  <StudentCard student={person} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="students-empty" data-students-empty hidden>
        {tr.noGraduatesInLine}
      </p>
    </div>
  </section>
</Layout>
