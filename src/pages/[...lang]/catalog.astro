---
import Layout from '../../layouts/Layout.astro';
import { getContent } from '../../data/site';
import { langFromParam, langPaths, t } from '../../i18n';

export const getStaticPaths = () => langPaths();

const lang = langFromParam(Astro.params.lang);
const tr = t(lang).catalog;
const { catalogFilterData, catalogTypologies, catalogYears, researchLines } = getContent(lang);
const catalogJson = JSON.stringify(catalogFilterData).replace(/</g, '\\u003c');
---

<Layout title={tr.title} description={t(lang).meta.catalog}>
  <section class="page-section wrap" aria-labelledby="catalog-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">{tr.title}</p>
      <h1 id="catalog-heading" class="page-head__title">{tr.title}</h1>
      <p class="page-head__lede">{tr.lede(catalogFilterData.length)}</p>
    </header>

    <form
      class="catalog-filters"
      role="search"
      onsubmit="return false"
      data-msg-none={tr.noResults}
      data-msg-empty={tr.emptyHint}
      data-msg-one={tr.results(1)}
      data-msg-many={tr.results(0).replace('0', '{n}')}
    >
      <label class="catalog-filters__search">
        <span>{tr.search}</span>
        <input
          id="catalog-q"
          type="search"
          name="q"
          placeholder={tr.searchPlaceholder}
          autocomplete="off"
        />
      </label>

      <label class="catalog-filters__field">
        <span>{tr.type}</span>
        <select id="catalog-typology">
          <option value="all">{tr.all}</option>
          {
            catalogTypologies.map(([value, label]) => (
              <option value={value}>{label}</option>
            ))
          }
        </select>
      </label>

      <label class="catalog-filters__field">
        <span>{tr.line}</span>
        <select id="catalog-line">
          <option value="all">{tr.allFem}</option>
          {researchLines.map((line) => <option value={line.id}>{line.title}</option>)}
        </select>
      </label>

      <label class="catalog-filters__field catalog-filters__field--year">
        <span>{tr.year}</span>
        <select id="catalog-year">
          <option value="all">{tr.all}</option>
          {catalogYears.map((year) => <option value={year}>{year}</option>)}
        </select>
      </label>

      <div class="catalog-filters__clear">
        <button type="button" id="catalog-clear" class="btn btn--ghost">
          {tr.clear}
        </button>
      </div>
    </form>

    <p id="catalog-meta" class="catalog-meta" aria-live="polite"></p>

    <ul id="catalog-results" class="works-list"></ul>
  </section>

  <script id="catalog-data" type="application/json" set:html={catalogJson} />
</Layout>
