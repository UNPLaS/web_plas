---
import { withBase } from '../../lib/with-base';
import Layout from '../../layouts/Layout.astro';
import TypeChip from '../../components/TypeChip.astro';
import { projectItems } from '../../data/placeholders';
---

<Layout title="Proyectos">
  <section class="page-section wrap" aria-labelledby="projects-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">Proyectos</p>
      <h1 id="projects-heading" class="page-head__title">Proyectos</h1>
      <p class="page-head__lede">
        Herramientas, plataformas y líneas de obra que el grupo construye y mantiene.
      </p>
    </header>

    <ul class="blog-list">
      {
        projectItems.map((item) => (
          <li>
            <a class="blog-card" href={withBase(`/projects/${item.id}`)}>
              <div class="blog-card__media">
                {item.image ? <img src={item.image} alt="" loading="lazy" /> : null}
              </div>
              <div class="blog-card__body">
                {
                  item.lineChip ? (
                    <div class="works-card__chips">
                      <TypeChip typology={item.lineChip} />
                    </div>
                  ) : null
                }
                <h2 class="blog-card__title">{item.title}</h2>
                <p class="blog-card__excerpt">{item.summary}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
