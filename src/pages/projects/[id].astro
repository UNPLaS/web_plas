---
import Layout from '../../layouts/Layout.astro';
import { projectItems } from '../../data/placeholders';

export function getStaticPaths() {
  return projectItems.map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

interface Props {
  item: (typeof projectItems)[number];
}

const { item } = Astro.props;
const related = projectItems.filter((entry) => entry.id !== item.id).slice(0, 3);
const description =
  item.sections.find((s) => s.key === 'description')?.body ?? item.summary;
---

<Layout title={item.title}>
  <article class="page-section page-section--tight wrap">
    <p class="page-back">
      <a href="/projects">← Volver a proyectos</a>
    </p>

    <header class="page-head">
      <p class="page-head__eyebrow">{item.meta}</p>
      <h1 class="page-head__title">{item.titleFull || item.title}</h1>
      <p class="page-head__lede">{item.summary}</p>
      <p class="card-outcome">{item.outcome}</p>
    </header>

    {
      item.image && (
        <div class="detail-media">
          <img src={item.image} alt="" loading="lazy" />
        </div>
      )
    }

    <div class="page-prose">
      {item.sections.map((section) => (
        <section>
          {section.key !== 'description' && <h2>{section.heading}</h2>}
          <p>{section.body}</p>
        </section>
      ))}
      {item.sections.length === 0 && <p>{description}</p>}
      {
        item.links.length > 0 && (
          <ul>
            {item.links.map((link) => (
              <li>
                <a href={link.url} target="_blank" rel="noreferrer">
                  {link.context || link.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="news-section wrap detail-related" aria-labelledby="related-heading">
        <div class="news-section__head">
          <h2 id="related-heading" class="news-section__title">Otros proyectos</h2>
          <a class="btn btn--soft" href="/projects">Ver todas</a>
        </div>
        <ul class="news-gallery">
          {related.map((entry) => (
            <li>
              <a class="news-card" href={`/projects/${entry.id}`}>
                <div class="news-card__media">
                  {entry.image ? <img src={entry.image} alt="" loading="lazy" /> : null}
                </div>
                <div class="news-card__body">
                  <p class="news-card__meta">{entry.meta}</p>
                  <h3 class="news-card__title">{entry.title}</h3>
                  <p class="card-outcome">{entry.outcome}</p>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Layout>
