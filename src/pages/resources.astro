---
import Layout from '../layouts/Layout.astro';
import { resourceSections } from '../data/placeholders';
---

<Layout title="Recursos">
  <section class="page-section wrap" aria-labelledby="resources-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">Recursos</p>
      <h1 id="resources-heading" class="page-head__title">Recursos</h1>
      <p class="page-head__lede">
        Plantillas, presentaciones y materiales de apoyo del grupo para investigación y formación.
      </p>
    </header>

    {
      resourceSections.map((sec) => (
        <section class="resource-block" id={sec.key} aria-labelledby={`resource-${sec.key}`}>
          <h2 id={`resource-${sec.key}`} class="people-section__title">
            {sec.title}
          </h2>
          <ul class="works-list">
            {sec.items.map((item) => {
              const actions =
                item.links.length > 1
                  ? item.links
                  : item.href
                    ? [{ url: item.href, label: 'Abrir →', is_primary: true }]
                    : [];
              return (
                <li id={item.id}>
                  <article class="works-card resource-card">
                    <div class="works-card__body">
                      <h3 class="works-card__title">{item.title}</h3>
                      {item.author && <p class="works-card__author">{item.author}</p>}
                      {actions.length > 0 && (
                        <p class="resource-card__actions">
                          {actions.map((link) => (
                            <a href={link.url} target="_blank" rel="noreferrer">
                              {link.label}
                            </a>
                          ))}
                        </p>
                      )}
                    </div>
                  </article>
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </section>
</Layout>
