---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Timeline from '../components/Timeline.astro';
import CtaGroup from '../components/CtaGroup.astro';
import SectionPanel from '../components/SectionPanel.astro';
import { aboutSections, timeline, ctas } from '../data/placeholders';
---

<Layout title="About" pattern="sections">
  <SectionPanel>
    <PageHeader
      title="About"
      lead="Estructura: page-header → bloques de texto → timeline → CTA de cierre."
    />
  </SectionPanel>

  {
    aboutSections.map((sec) => (
      <SectionPanel>
        <section id={sec.id} class="scroll-mt-24" data-pattern="stacked-section">
          <h2 class="font-display text-2xl font-semibold">{sec.title}</h2>
          <p class="mt-3 max-w-2xl text-[var(--muted)]">{sec.body}</p>
        </section>
      </SectionPanel>
    ))
  }

  <SectionPanel>
    <Timeline items={[...timeline]} />
  </SectionPanel>

  <SectionPanel>
    <CtaGroup items={[ctas[0], ctas[1], ctas[2]]} />
  </SectionPanel>
</Layout>
