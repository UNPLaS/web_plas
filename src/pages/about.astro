---
import Layout from '../layouts/Layout.astro';
import { aboutBlocks } from '../data/placeholders';
---

<Layout title="Sobre el grupo">
  <section class="page-section wrap" aria-labelledby="about-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">About</p>
      <h1 id="about-heading" class="page-head__title">Sobre el grupo</h1>
      <p class="page-head__lede">
        Quiénes somos y cómo trabajamos.
      </p>
    </header>

    <ul class="about-blocks">
      {
        aboutBlocks.map((block) => (
          <li class="about-card">
            <h2 class="about-card__title">{block.title}</h2>
            <p class="about-card__text">{block.body}</p>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
