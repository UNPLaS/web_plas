---
import Layout from '../../layouts/Layout.astro';
import { eventItems } from '../../data/placeholders';
---

<Layout title="Eventos">
  <section class="page-section wrap" aria-labelledby="events-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">Eventos</p>
      <h1 id="events-heading" class="page-head__title">Eventos</h1>
      <p class="page-head__lede">
        Talleres, charlas y encuentros del grupo con la comunidad académica.
      </p>
    </header>

    <ul class="blog-list">
      {
        eventItems.map((item) => (
          <li>
            <a class="blog-card" href={`/events/${item.id}`}>
              <div class="blog-card__media" aria-hidden="true" />
              <div class="blog-card__body">
                <p class="blog-card__meta">{item.meta}</p>
                <h2 class="blog-card__title">{item.title}</h2>
                <p class="blog-card__excerpt">{item.summary}</p>
                <p class="card-outcome">{item.outcome}</p>
              </div>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
