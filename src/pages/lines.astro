---
import Layout from '../layouts/Layout.astro';
import { researchLines } from '../data/placeholders';
---

<Layout title="Líneas de investigación">
  <section class="page-section wrap" aria-labelledby="lines-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">Líneas</p>
      <h1 id="lines-heading" class="page-head__title">Líneas de investigación</h1>
      <p class="page-head__lede">
        Áreas en las que el grupo concentra su trabajo académico y de formación.
      </p>
    </header>

    <ul class="lines-list">
      {
        researchLines.map((line) => (
          <li>
            <article
              class="lines-card"
              style={line.color ? `--line-color: ${line.color}` : undefined}
            >
              <h2 class="lines-card__title">{line.title}</h2>
              <p class="lines-card__text">{line.text}</p>
              {line.topics.length > 0 && (
                <ul class="lines-card__topics">
                  {line.topics
                    .slice()
                    .sort((a, b) => a.sort_order - b.sort_order)
                    .map((t) => (
                      <li>{t.topic}</li>
                    ))}
                </ul>
              )}
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
