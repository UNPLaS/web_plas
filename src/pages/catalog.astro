---
import Layout from '../layouts/Layout.astro';
import { catalogItems } from '../data/placeholders';
---

<Layout title="Catálogo">
  <section class="page-section wrap" aria-labelledby="catalog-heading">
    <header class="page-head">
      <p class="page-head__eyebrow">Catálogo</p>
      <h1 id="catalog-heading" class="page-head__title">Catálogo</h1>
      <p class="page-head__lede">
        Publicaciones y tesis del grupo. Búsqueda simple (sin filtros aún).
      </p>
    </header>

    <div class="catalog-search">
      <label>
        Buscar
        <input type="search" name="q" placeholder="Título o autor…" />
      </label>
    </div>

    <ul class="works-list">
      {
        catalogItems.map((item) => (
          <li>
            <article class="works-card works-card--thumb">
              <div class="works-card__media" aria-hidden="true" />
              <div class="works-card__body">
                <p class="works-card__meta">{item.meta}</p>
                <h2 class="works-card__title">{item.title}</h2>
                <p class="works-card__author">{item.author}</p>
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
