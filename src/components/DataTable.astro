---
import PatternLabel from './PatternLabel.astro';

interface Row {
  year: string;
  colA: string;
  colB: string;
  colC: string;
}

interface Props {
  rows: Row[];
}

const { rows } = Astro.props;
---

<section data-pattern="data-table">
  <PatternLabel id="data-table" name="Tabla densa" />
  <div class="overflow-x-auto border-t border-[var(--line)]">
    <table class="w-full min-w-[36rem] text-left text-sm">
      <thead>
        <tr class="border-b border-[var(--line)] text-xs uppercase tracking-wide text-[var(--muted)]">
          <th class="py-3 pr-4 font-semibold">Año</th>
          <th class="py-3 pr-4 font-semibold">Columna A</th>
          <th class="py-3 pr-4 font-semibold">Columna B</th>
          <th class="py-3 font-semibold">Columna C</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr class="border-b border-[var(--line)]">
              <td class="py-3 pr-4 whitespace-nowrap">{row.year}</td>
              <td class="py-3 pr-4">{row.colA}</td>
              <td class="py-3 pr-4">{row.colB}</td>
              <td class="py-3">{row.colC}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</section>
