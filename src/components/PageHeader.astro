---
import PatternLabel from './PatternLabel.astro';

interface Props {
  title: string;
  lead?: string;
  showLabel?: boolean;
}

const { title, lead, showLabel = true } = Astro.props;
---

<header class="mb-0" data-pattern="page-header">
  {showLabel && <PatternLabel id="page-header" name="Page header" />}
  <h1 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">{title}</h1>
  {lead && <p class="mt-3 max-w-2xl text-[var(--muted)]">{lead}</p>}
</header>
