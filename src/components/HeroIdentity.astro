---
import PatternLabel from './PatternLabel.astro';
import ChipList from './ChipList.astro';

interface Props {
  brand: string;
  title: string;
  subtitle?: string;
  chips?: string[];
  /** brand = PLaS (logo); person = Felipe (retrato). Se sincroniza con el tema. */
  mode?: 'brand' | 'person';
}

const { brand, title, subtitle, chips = [], mode = 'brand' } = Astro.props;
---

<section
  class="content-panel content-panel--flush hero-bleed"
  data-pattern="hero-identity"
  data-theme-sync
  data-mode={mode}
>
  <div class="hero-bleed__media" aria-hidden="true">
    <img
      class="hero-bleed__img hero-bleed__img--plas"
      src="/images/hero-plas.png"
      alt=""
      width="1920"
      height="1080"
      decoding="async"
      fetchpriority="high"
    />
    <img
      class="hero-bleed__img hero-bleed__img--felipe"
      src="/images/hero-felipe.png"
      alt=""
      width="1920"
      height="1080"
      decoding="async"
    />
  </div>

  <div class="hero-bleed__panel">
    <PatternLabel id="hero-identity" name="Hero identidad (educación → crecimiento)" />
    <p class="motion-rise mb-4 text-xs font-semibold uppercase tracking-[0.18em] text-[var(--accent)]">
      {brand}
    </p>
    <div class="relative flex flex-col gap-6 sm:flex-row sm:items-end">
      <div
        class="mark flex h-24 w-24 shrink-0 items-center justify-center border-2 border-[var(--accent-2)] bg-[var(--surface)] text-xs font-semibold uppercase tracking-wide text-[var(--muted)] sm:h-28 sm:w-28"
        data-mark
        aria-hidden="true"
      >
        <span data-mark-brand>Logo</span>
        <span data-mark-person class="hidden">Foto</span>
      </div>
      <div class="min-w-0">
        <h1
          class="motion-rise motion-rise-delay-1 font-display text-3xl leading-[1.05] tracking-tight text-[var(--ink)] sm:text-4xl md:text-5xl"
          style={`font-weight: var(--hero-weight)`}
        >
          {title}
        </h1>
        {
          subtitle && (
            <p class="motion-rise motion-rise-delay-2 mt-3 max-w-md text-base text-[var(--muted)] md:text-lg">
              {subtitle}
            </p>
          )
        }
        {
          chips.length > 0 && (
            <div class="motion-rise motion-rise-delay-3 mt-5">
              <ChipList items={chips} />
            </div>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  [data-mode='person'] [data-mark] {
    border-radius: 9999px;
    border-color: var(--warm);
  }
  [data-mode='brand'] [data-mark] {
    border-radius: 0.2rem 1.5rem 0.2rem 1.5rem;
  }
  [data-mode='person'] [data-mark-brand] {
    display: none;
  }
  [data-mode='person'] [data-mark-person] {
    display: inline;
  }
</style>
