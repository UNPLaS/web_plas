---
import PatternLabel from './PatternLabel.astro';

interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<section class="growth-canvas" data-pattern="claim-list">
  <PatternLabel id="claim-list" name="Frases clave (ramas del relato)" />
  <ul class="space-y-5">
    {
      items.map((text, i) => (
        <li class:list={['branch-node max-w-2xl text-lg text-[var(--ink)]/90', `motion-rise motion-rise-delay-${Math.min(i + 1, 3)}`]}>
          {text}
        </li>
      ))
    }
  </ul>
</section>
