---
import PatternLabel from './PatternLabel.astro';

interface Item {
  id: string;
  title: string;
  year: string;
  typology: string;
  authors: string;
  venue: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<section class="growth-canvas mt-8" data-pattern="result-list">
  <PatternLabel id="result-list" name="Resultados como hojas del catálogo" />
  <ul class="space-y-6">
    {
      items.map((item) => (
        <li class="branch-node">
          <p class="text-xs font-semibold uppercase tracking-wide text-[var(--muted)]">
            {item.typology} · {item.year}
          </p>
          <h3 class="font-display mt-1 text-base font-semibold">{item.title}</h3>
          <p class="mt-1 text-sm text-[var(--muted)]">{item.authors}</p>
          {item.venue && <p class="mt-0.5 text-sm text-[var(--muted)]">{item.venue}</p>}
        </li>
      ))
    }
  </ul>
</section>
