---
import PatternLabel from './PatternLabel.astro';

interface Field {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  fields: Field[];
}

const { fields } = Astro.props;
---

<section data-pattern="contact-block">
  <PatternLabel id="contact-block" name="Bloque de contacto" />
  <dl class="space-y-4">
    {
      fields.map((field) => (
        <div class="border-t border-[var(--line)] pt-4">
          <dt class="text-xs font-semibold uppercase tracking-wide text-[var(--muted)]">
            {field.label}
          </dt>
          <dd class="mt-1">
            {field.href ? <a href={field.href}>{field.value}</a> : field.value}
          </dd>
        </div>
      ))
    }
  </dl>
  <div
    class="mt-10 flex aspect-[16/6] items-center justify-center border border-[var(--line)] bg-[var(--surface)] text-sm text-[var(--muted)]"
    aria-hidden="true"
  >
    [mapa / ubicación placeholder]
  </div>
</section>
