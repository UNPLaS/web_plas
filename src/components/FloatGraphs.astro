---
/**
 * Fase 3 — red flotante recortada al lado blanco del spine.
 * Disco a escala full-page; deriva por dirección del mouse;
 * restore al superar umbral de deriva (fade → ancla → fade in).
 */
---

<svg
  class="float-graphs"
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <clipPath id="float-graphs-clip" clipPathUnits="userSpaceOnUse">
      <path class="float-graphs__clip" d="" />
    </clipPath>
  </defs>
  <g clip-path="url(#float-graphs-clip)">
    <g class="float-graphs__mesh"></g>
  </g>
</svg>

<script>
  import { startNetworkDrift } from '../scripts/network-drift';
  startNetworkDrift();
  requestAnimationFrame(startNetworkDrift);
  window.addEventListener('load', startNetworkDrift);
</script>
