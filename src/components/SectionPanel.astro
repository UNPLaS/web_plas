---
/**
 * Contenedor de sección: color de tema + bordes ligeramente redondeados
 * sobre el fondo blanco de página.
 */
interface Props {
  class?: string;
  as?: 'section' | 'div' | 'article';
}

const { class: className = '', as: Tag = 'section' } = Astro.props;
---

<Tag class:list={['content-panel', className]}>
  <slot />
</Tag>
