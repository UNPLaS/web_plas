---
/**
 * Espina diagonal + split bicolor (solo home).
 * Geometría en spine-sync.ts (alineada al panel del hero).
 */
---

<svg
  class="spine"
  viewBox="0 0 100 100"
  preserveAspectRatio="none"
  aria-hidden="true"
  focusable="false"
>
  <path class="spine__fill spine__fill--left" d="" />
  <path class="spine__fill spine__fill--right" d="" />
  <polyline
    class="spine__path"
    fill="none"
    points="90,7 0,28 100,52 0,72 100,90"
    vector-effect="non-scaling-stroke"
  />
</svg>
