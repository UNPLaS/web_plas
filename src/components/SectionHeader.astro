---
import PatternLabel from './PatternLabel.astro';

interface Props {
  title: string;
  lead?: string;
  showLabel?: boolean;
}

const { title, lead, showLabel = true } = Astro.props;
---

<div class="mb-6" data-pattern="section-header">
  {showLabel && <PatternLabel id="section-header" name="Section header" />}
  <h2 class="font-display text-2xl font-semibold tracking-tight">
    <span class="geo-mark" aria-hidden="true"></span>
    {title}
  </h2>
  {lead && <p class="mt-2 max-w-2xl text-[var(--muted)]">{lead}</p>}
</div>
