---
import PatternLabel from './PatternLabel.astro';
import ItemCard from './ItemCard.astro';

interface Item {
  id?: string;
  title: string;
  meta?: string;
  summary?: string;
  href?: string;
}

interface Props {
  items: Item[];
  showLabel?: boolean;
}

const { items, showLabel = true } = Astro.props;
---

<section class="growth-canvas" data-pattern="item-grid">
  {showLabel && <PatternLabel id="item-grid" name="Índice como ramas (no tarjetas)" />}
  <ul class="fork-layout">
    {
      items.map((item) => (
        <li>
          <ItemCard
            title={item.title}
            meta={item.meta}
            summary={item.summary}
            href={item.href ?? (item.id ? `/collection/${item.id}` : undefined)}
          />
        </li>
      ))
    }
  </ul>
</section>
