---
/**
 * Motivo de crecimiento (árbol / bifurcaciones).
 * Misma geometría en ambos temas; el color lo dan los tokens.
 */
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 320 320"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    class="trunk"
    d="M160 300 V120"
    stroke="var(--branch)"
    stroke-width="3"
    stroke-linecap="round"
  ></path>
  <path
    d="M160 220 L70 150"
    stroke="var(--branch)"
    stroke-width="2.5"
    stroke-linecap="round"
    opacity="0.85"
  ></path>
  <path
    d="M160 180 L250 100"
    stroke="var(--branch)"
    stroke-width="2.5"
    stroke-linecap="round"
    opacity="0.85"
  ></path>
  <path
    d="M160 140 L95 70"
    stroke="var(--accent-2)"
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.9"
  ></path>
  <path
    d="M160 140 L230 55"
    stroke="var(--accent)"
    stroke-width="2"
    stroke-linecap="round"
    opacity="0.75"
  ></path>
  <circle cx="70" cy="150" r="7" fill="var(--node)"></circle>
  <circle cx="250" cy="100" r="7" fill="var(--accent-2)"></circle>
  <circle cx="95" cy="70" r="6" fill="var(--accent-3)"></circle>
  <circle cx="230" cy="55" r="6" fill="var(--warm)"></circle>
  <circle cx="160" cy="120" r="8" fill="var(--accent)"></circle>
</svg>
