---
interface Props {
  title: string;
  meta?: string;
  summary?: string;
  href?: string;
}

const { title, meta, summary, href } = Astro.props;
---

<article class="branch-node" data-pattern="item-card">
  <h3 class="font-display text-lg font-semibold">
    {
      href ? (
        <a href={href} class="text-[var(--ink)] no-underline hover:underline">
          {title}
        </a>
      ) : (
        title
      )
    }
  </h3>
  {meta && <p class="mt-1 text-sm text-[var(--muted)]">{meta}</p>}
  {summary && <p class="mt-2 text-sm text-[var(--ink)]/85">{summary}</p>}
</article>
