---
import ThemeSwitch from './ThemeSwitch.astro';
import { nav, site } from '../data/placeholders';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-[var(--panel-border)] bg-[var(--page)]" data-pattern="shell-header">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-6 py-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <a href="/" class="font-display text-lg font-semibold text-[var(--ink)] no-underline">
        <span class="geo-mark" aria-hidden="true"></span>
        {site.name}
      </a>
      <ThemeSwitch />
    </div>
    <nav aria-label="Principal" class="flex flex-wrap gap-x-4 gap-y-2 text-sm">
      {
        nav.map((item) => {
          const active =
            item.href === '/'
              ? pathname === '/'
              : pathname === item.href || pathname.startsWith(`${item.href}/`);
          return (
            <a
              href={item.href}
              class:list={[
                'no-underline hover:underline',
                active ? 'font-semibold text-[var(--ink)]' : 'text-[var(--muted)]',
              ]}
              aria-current={active ? 'page' : undefined}
              title={`pattern: ${item.pattern}`}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
