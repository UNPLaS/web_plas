---
import { nav, site } from '../data/placeholders';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="site-header border-b py-4">
  <div class="wrap flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <a href="/" class="font-semibold no-underline">{site.name}</a>
    <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Principal">
      {
        nav.map((item) => {
          const active =
            item.href === '/'
              ? pathname === '/'
              : pathname === item.href || pathname.startsWith(`${item.href}/`);
          return (
            <a
              href={item.href}
              class="no-underline"
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
