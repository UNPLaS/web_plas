---
import { nav, site } from '../data/placeholders';
import { isActivePath, withBase } from '../lib/with-base';

const pathname = Astro.url.pathname;
const homeHref = withBase('/');
---

<header class="site-header border-b py-4">
  <div class="wrap flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <a href={homeHref} class="site-header__brand no-underline">{site.name}</a>
    <nav class="flex flex-wrap gap-x-4 gap-y-2 text-sm" aria-label="Principal">
      {
        nav.map((item) => {
          const active = isActivePath(pathname, item.href);
          return (
            <a
              href={item.href}
              class="no-underline"
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>
  </div>
</header>
