---
import PatternLabel from './PatternLabel.astro';

interface Cta {
  title: string;
  text: string;
  primary: { href: string; label: string };
  secondary?: { href: string; label: string };
}

interface Props {
  items: Cta[];
}

const { items } = Astro.props;
---

<section data-pattern="cta-group">
  <PatternLabel id="cta-group" name="Puertas / bifurcaciones" />
  <ul class="fork-layout">
    {
      items.map((cta) => (
        <li class="leaf-panel">
          <h2 class="font-display text-xl font-semibold text-[var(--ink)]">{cta.title}</h2>
          <p class="mt-2 text-sm text-[var(--muted)]">{cta.text}</p>
          <p class="mt-4 flex flex-wrap gap-4 text-sm font-semibold">
            <a href={cta.primary.href}>{cta.primary.label}</a>
            {cta.secondary && (
              <a href={cta.secondary.href} class="font-normal">
                {cta.secondary.label}
              </a>
            )}
          </p>
        </li>
      ))
    }
  </ul>
</section>
