---
/**
 * Etiqueta de patrón (auditoría).
 * Desactivada: no renderiza nada. Reactivar con AUDIT = true.
 */
interface Props {
  id: string;
  name: string;
}

const AUDIT = false;
const { id, name } = Astro.props;
---

{
  AUDIT ? (
    <p
      class="mb-3 font-mono text-[0.65rem] font-semibold uppercase tracking-[0.14em] text-[var(--label)] opacity-80"
      data-pattern={id}
    >
      [{id}] {name}
    </p>
  ) : null
}
