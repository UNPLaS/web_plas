---
import PatternLabel from './PatternLabel.astro';

interface Props {
  items: string[];
  showLabel?: boolean;
}

const { items, showLabel = false } = Astro.props;
---

<div data-pattern="chip-list">
  {showLabel && <PatternLabel id="chip-list" name="Chips / nodos" />}
  <ul class="flex flex-wrap gap-2">
    {
      items.map((item) => (
        <li class="border border-[var(--line)] bg-[color-mix(in_srgb,var(--surface)_70%,transparent)] px-2.5 py-1 text-xs font-medium text-[var(--muted)]">
          <span class="geo-mark !mr-1.5 !h-2 !w-2" aria-hidden="true" />
          {item}
        </li>
      ))
    }
  </ul>
</div>
