---
import { renderMarkdown } from '../lib/render-markdown';
import { langOf } from '../i18n';

interface Props {
  content: string;
  class?: string;
}

const { content, class: className = 'page-prose' } = Astro.props;
const html = renderMarkdown(content, langOf(Astro.url));
---

{html ? <div class={className} set:html={html} /> : null}
