---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Spine from '../components/Spine.astro';
import FloatGraphs from '../components/FloatGraphs.astro';
import { site } from '../data/placeholders';

interface Props {
  title: string;
  description?: string;
  /** Espina diagonal de fondo — solo home por ahora. */
  spine?: boolean;
}

const { title, description = site.tagline, spine = false } = Astro.props;
const isHome = Astro.url.pathname.replace(/\/$/, '') === '' || Astro.url.pathname === '/';
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title} — {site.name}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class:list={['page-shell', spine ? 'page-shell--split' : 'page-shell--interior']}>
      {spine && <Spine />}
      {spine && <FloatGraphs />}
      {spine && <div class="page-bg-veil" aria-hidden="true" />}
      <div class="page-foreground">
        <SiteHeader />
        {!isHome && <Breadcrumb currentLabel={title} />}
        <main class="page-main">
          <slot />
        </main>
        <SiteFooter />
      </div>
    </div>
    <script>
      import { startTouchHover } from '../scripts/touch-hover';
      startTouchHover();
    </script>
  </body>
</html>
