---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/unal-chrome.css';
import UnalHeader from '../components/unal/UnalHeader.astro';
import UnalServices from '../components/unal/UnalServices.astro';
import UnalAccessibility from '../components/unal/UnalAccessibility.astro';
import UnalFooter from '../components/unal/UnalFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Spine from '../components/Spine.astro';
import FloatGraphs from '../components/FloatGraphs.astro';
import { getContent } from '../data/site';
import { withBase } from '../lib/with-base';
import { LANGS, DEFAULT_LANG, localePath, otherLang, splitLocale, t, type Lang } from '../i18n';
import { LANG_KEY } from '../scripts/lang-switch';

interface Props {
  title: string;
  description?: string;
  /** Espina diagonal de fondo — solo home por ahora. */
  spine?: boolean;
  /** Slug de línea: reemplaza la familia mid del sitio por la de esa línea (ver global.css). */
  lineTheme?: string;
  /** Vista previa en redes: `article` para entradas del blog y proyectos. */
  ogType?: 'website' | 'article' | 'profile';
  /** Páginas que no deben aparecer en buscadores (p. ej. 404). */
  noindex?: boolean;
}

const { lang, path } = splitLocale(Astro.url.pathname);
const dict = t(lang);
const { site } = getContent(lang);

const {
  title,
  description = site.tagline,
  spine = false,
  lineTheme,
  ogType = 'website',
  noindex = false,
} = Astro.props;
function clip(text: string, max = 180) {
  const plain = text.replace(/[*_`#>\[\]]/g, '').replace(/\s+/g, ' ').trim();
  if (plain.length <= max) return plain;
  return `${plain.slice(0, plain.lastIndexOf(' ', max - 1)).replace(/[,;:.]$/, '')}…`;
}
const metaDescription = clip(description);
const isHome = path === '/';
const pageTitle = title.includes(dict.university) ? title : `${title} | ${dict.university}`;
/** El sitio oficial es plas.unal.edu.co; la copia en GitHub Pages apunta ahí como canónica. */
function canonicalFor(l: Lang) {
  const p = l === DEFAULT_LANG ? path : `/${l}${path === '/' ? '' : path}`;
  return new URL(p === '/' ? '/' : `${p}/`, 'https://plas.unal.edu.co').href;
}
const canonical = canonicalFor(lang);
/** La misma página en el otro idioma (con la base del despliegue); la 404 cae al inicio. */
const langAlt = localePath(otherLang(lang), noindex ? '/' : path);
const ogImage = new URL(withBase('/images/og/plas.jpg'), Astro.site).href;
const favicon = withBase('/favicon.ico');
const escudoPreload = withBase('/unal/images/escudoUnal.svg');
const sealPreload = withBase('/unal/images/sealColombia.png');
const unalChromeJs = withBase('/unal/js/unal-chrome.js');
---

<!doctype html>
<html lang={lang} data-lang-alt={langAlt}>
  <head>
    <meta charset="utf-8" />
    {
      !noindex && (
        <script is:inline define:vars={{ LANG_KEY }}>
          // Primera visita: idioma del navegador (es si es el primero entre es/en; si no, en).
          try {
            if (
              !localStorage.getItem(LANG_KEY) &&
              !/bot|crawl|spider|slurp|preview|lighthouse|headless/i.test(navigator.userAgent)
            ) {
              var root = document.documentElement;
              var prefs = navigator.languages && navigator.languages.length ? navigator.languages : [navigator.language || ''];
              var pick = 'en';
              for (var i = 0; i < prefs.length; i++) {
                var code = String(prefs[i]).slice(0, 2).toLowerCase();
                if (code === 'es' || code === 'en') {
                  pick = code;
                  break;
                }
              }
              localStorage.setItem(LANG_KEY, pick);
              if (pick !== root.lang && root.dataset.langAlt) {
                location.replace(root.dataset.langAlt + location.search + location.hash);
              }
            }
          } catch (e) {}
        </script>
      )
    }
    <link rel="shortcut icon" href={favicon} type="image/x-icon" />
    <link rel="icon" href={favicon} type="image/x-icon" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={metaDescription} />
    <title>{pageTitle}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && LANGS.map((l) => <link rel="alternate" hreflang={l} href={canonicalFor(l)} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonicalFor(DEFAULT_LANG)} />}
    <link rel="sitemap" href={withBase('/sitemap-index.xml')} />

    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={`${site.name} — ${dict.university}`} />
    <meta property="og:locale" content={dict.ogLocale} />
    {
      !noindex && (
        <meta property="og:locale:alternate" content={t(otherLang(lang)).ogLocale} />
      )
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${site.nameFull}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />

    <Font cssVariable="--font-source-sans" />
    <Font cssVariable="--font-onest" />
    <Font cssVariable="--font-source-serif" />
    <link rel="preload" href={escudoPreload} as="image" type="image/svg+xml" />
    <link rel="preload" href={sealPreload} as="image" type="image/png" />
    <ClientRouter />
  </head>
  <body class="unal-shell" data-line-theme={lineTheme}>
    <UnalHeader />
    <UnalAccessibility />
    <UnalServices />

    <main id="unal-site-content" class="plas-main">
      <div class:list={['page-shell', spine ? 'page-shell--split' : 'page-shell--interior']}>
        {spine && <Spine />}
        {spine && <FloatGraphs />}
        {spine && <div class="page-bg-veil" aria-hidden="true" />}
        <div class="page-foreground">
          {
            !isHome && (
              <div class="plas-chrome-static">
                <Breadcrumb currentLabel={title} />
              </div>
            )
          }
          <div class="page-main" data-plas-content>
            <slot />
          </div>
        </div>
      </div>
    </main>

    <UnalFooter />
    <script src={unalChromeJs} defer></script>
    <script>
      import { startTouchHover } from '../scripts/touch-hover';
      import { markExternalLinks } from '../scripts/external-links';
      import { initTopicGraphMotion } from '../scripts/topic-graph-motion';
      import { startNetworkDrift } from '../scripts/network-drift';
      import { syncSpineAndHeroPanel } from '../scripts/spine-sync';
      import { initCatalogFilters } from '../scripts/catalog-filters';
      import { initTopicAnchors } from '../scripts/topic-anchors';
      import { initStudentDialogs } from '../scripts/student-dialogs';
      import { initStudentFilters } from '../scripts/student-filters';
      import { initFacultyTabs } from '../scripts/faculty-tabs';
      import { isActivePath } from '../lib/with-base';
      import { pickHomeQuote } from '../scripts/home-quote';
      import { initLangSwitch } from '../scripts/lang-switch';

      function syncPersistedNav() {
        const path = window.location.pathname;
        document.querySelectorAll('#unal-main-nav a[href]').forEach((node) => {
          const a = node as HTMLAnchorElement;
          const href = a.getAttribute('href') || '';
          if (!href.startsWith('/')) return;
          if (isActivePath(path, href)) a.setAttribute('aria-current', 'page');
          else a.removeAttribute('aria-current');
        });
      }

      let spineResizeBound = false;

      document.addEventListener('astro:page-load', () => {
        syncPersistedNav();
        initLangSwitch();
        startTouchHover();
        markExternalLinks();
        initTopicGraphMotion();
        syncSpineAndHeroPanel();
        startNetworkDrift();
        pickHomeQuote();
        requestAnimationFrame(() => {
          syncSpineAndHeroPanel();
          startNetworkDrift();
        });
        document.fonts?.ready.then(() => syncSpineAndHeroPanel());
        initCatalogFilters();
        initTopicAnchors();
        initStudentDialogs();
        initStudentFilters();
        initFacultyTabs();

        const content = document.querySelector<HTMLElement>('[data-plas-content]');
        if (content && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          content.classList.remove('plas-content-enter');
          void content.offsetWidth;
          content.classList.add('plas-content-enter');
        }

        if (!spineResizeBound) {
          spineResizeBound = true;
          window.addEventListener('resize', syncSpineAndHeroPanel);
        }
      });
    </script>
  </body>
</html>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation: none !important;
    mix-blend-mode: normal;
    opacity: 1;
  }

  @keyframes plas-content-enter {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .page-main.plas-content-enter {
    animation: plas-content-enter 0.35s ease both;
  }

  @media (prefers-reduced-motion: reduce) {
    .page-main.plas-content-enter {
      animation: none;
    }
  }
</style>
