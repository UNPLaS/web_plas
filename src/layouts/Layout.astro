---
import '../styles/global.css';
import '../styles/unal-chrome.css';
import UnalHeader from '../components/unal/UnalHeader.astro';
import UnalServices from '../components/unal/UnalServices.astro';
import UnalAccessibility from '../components/unal/UnalAccessibility.astro';
import UnalFooter from '../components/unal/UnalFooter.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import Spine from '../components/Spine.astro';
import FloatGraphs from '../components/FloatGraphs.astro';
import { site } from '../data/placeholders';

interface Props {
  title: string;
  description?: string;
  /** Espina diagonal de fondo — solo home por ahora. */
  spine?: boolean;
}

const { title, description = site.tagline, spine = false } = Astro.props;
const isHome = Astro.url.pathname.replace(/\/$/, '') === '' || Astro.url.pathname === '/';
const pageTitle = title.includes('Universidad Nacional')
  ? title
  : `${title} | Universidad Nacional de Colombia`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Onest:wght@500;600;700&family=Source+Sans+3:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="unal-shell">
    <!-- B3: cabezote, accesibilidad, servicios → contenido PLaS → pie -->
    <UnalHeader />
    <UnalAccessibility />
    <UnalServices />

    <main id="unal-site-content" class="plas-main">
      <div class:list={['page-shell', spine ? 'page-shell--split' : 'page-shell--interior']}>
        {spine && <Spine />}
        {spine && <FloatGraphs />}
        {spine && <div class="page-bg-veil" aria-hidden="true" />}
        <div class="page-foreground">
          {!isHome && <Breadcrumb currentLabel={title} />}
          <div class="page-main">
            <slot />
          </div>
        </div>
      </div>
    </main>

    <UnalFooter />
    <script src="/unal/js/unal-chrome.js" defer></script>
    <script>
      import { startTouchHover } from '../scripts/touch-hover';
      import { markExternalLinks } from '../scripts/external-links';
      startTouchHover();
      markExternalLinks();
    </script>
  </body>
</html>
